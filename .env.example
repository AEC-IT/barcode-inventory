# Copy this file to ".env" and fill in your real values for local testing.
# On Render, set these same two values under Settings -> Environment instead
# of using a .env file.

DATABASE_URL=postgresql://user:password@ep-example-12345.region.aws.neon.tech/neondb?sslmode=require
SESSION_SECRET=change-this-to-any-random-text

# Optional: powers the "Scan Bill (AI)" button in the Bills tab. Leave these
# unset and everything else in the app works exactly as before - the button
# just stays hidden until both are set. From the Azure Portal, open your
# Document Intelligence resource -> "Keys and Endpoint".
AZURE_DOCINTEL_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
AZURE_DOCINTEL_KEY=your-key-1-from-the-azure-portal

# Optional: lets the separate Bill Scanner app push extracted bill line items
# and barcode captures into this app (POST /api/integrations/bill-scanner).
# Leave BILL_SCANNER_API_KEY unset to keep the integration switched off.
# Set the SAME value as SUPER_APP_API_KEY on the bill scanner.
BILL_SCANNER_API_KEY=generate-a-long-random-string
# Bill scanner's public URL, so its bill/capture image links open from here.
BILL_SCANNER_BASE_URL=https://your-bill-scanner.onrender.com
# Only needed if the bill scanner's vertical ids differ from ours. Values can
# be our numeric id or our vertical code. Example: {"uuid-of-studies":"aec-studies"}
BILL_SCANNER_VERTICAL_MAP={}

# Optional: store photos in SharePoint instead of the database (keeps the
# database tiny). Leave unset and photos stay in the database as before.
# Setup steps: SHAREPOINT-SETUP.md
MS_TENANT_ID=your-directory-tenant-id
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-app-client-secret-value
SHAREPOINT_SITE=https://yourcompany.sharepoint.com/sites/AssetPhotos
# Optional: top-level folder in the site's Documents library
SHAREPOINT_FOLDER=Barcode Inventory
